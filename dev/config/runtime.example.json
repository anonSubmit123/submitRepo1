{
  "components": {
    "provider": {
      "assignment_optimizer": {
        "factory": "runtime.providers:AStarRefocusAssignmentOptimizer",
        "scope": "singleton"
      },
      "surrogate_efficacy_provider": {
        "factory": "runtime.providers:MetadataSurrogateEfficacyProvider",
        "params": {
          "default_score": 0.5,
          "capability_weight": 0.1,
          "demand_penalty_weight": 0.05
        },
        "scope": "singleton"
      },
      "policy_bank": {
        "factory": "runtime.providers:InMemoryPolicyBank",
        "scope": "singleton"
      },
      "agent_policy_bank": {
        "ref": "policy_bank"
      },
      "shared_policy_bank": {
        "ref": "policy_bank"
      },
      "agent_environment": {
        "factory": "runtime.factory:SimulatorAgentEnvironment"
      }
    },
    "simulators": {
      "section42-wildfire": {
        "factory": "external_simulators.default_simulator:DefaultSimulator",
        "params": {
          "domain": "wildfire",
          "scenario_family": "section_4_2"
        }
      }
    }
  },
  "physical_systems": [
    {
      "id": "local-worker-1",
      "host": "127.0.0.1",
      "lifecycle_endpoint": {
        "host": "127.0.0.1",
        "port": 40901
      }
    },
    {
      "id": "local-worker-2",
      "host": "127.0.0.1",
      "lifecycle_endpoint": {
        "host": "127.0.0.1",
        "port": 40902
      }
    }
  ],
  "capability_profiles": {
    "small": {
      "extinguisher_capacity": 100,
      "speed": 30,
      "survey": 1
    },
    "medium": {
      "extinguisher_capacity": 250,
      "speed": 24,
      "survey": 1,
      "rescue": 1
    },
    "large": {
      "extinguisher_capacity": 600,
      "speed": 18,
      "rescue": 1
    }
  },
  "controllers": [
    {
      "id": "controller-1",
      "physical_system_id": "local-worker-1",
      "endpoint": {
        "host": "127.0.0.1",
        "port": 41000
      },
      "managed_agents": [
        "agent-1",
        "agent-2"
      ]
    }
  ],
  "agents": [
    {
      "id": "agent-1",
      "physical_system_id": "local-worker-1",
      "capability": "small",
      "endpoint": {
        "host": "127.0.0.1",
        "port": 41101
      },
      "controller_id": "controller-1",
      "policy_manager_id": "policy-manager-1",
      "simulator_id": "section42-wildfire",
      "simulator": {
        "role": "survey"
      }
    },
    {
      "id": "agent-2",
      "physical_system_id": "local-worker-2",
      "capability": "large",
      "endpoint": {
        "host": "127.0.0.1",
        "port": 41102
      },
      "controller_id": "controller-1",
      "policy_manager_id": "policy-manager-1",
      "simulator_id": "section42-wildfire",
      "simulator": {
        "role": "rescue"
      }
    }
  ],
  "policy_managers": [
    {
      "id": "policy-manager-1",
      "physical_system_id": "local-worker-1",
      "endpoint": {
        "host": "127.0.0.1",
        "port": 41200
      }
    }
  ],
  "admins": [
    {
      "id": "test-admin-1",
      "physical_system_id": "local-worker-1",
      "endpoint": {
        "host": "127.0.0.1",
        "port": 41300
      }
    }
  ]
}
